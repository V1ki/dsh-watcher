{
  "name": "@local/dsh-connector-github",
  "version": "0.1.0",
  "description": "DSH GitHub Connector — /notifications + ETag Repo Polling (+1 Reactions), Issue/PR Hybrid Topology, Persona Binding, git merge-tree Pre-check, Auto-Send/Draft Outbound & Dedicated Sidebar UI",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./poller": {
      "types": "./lib/poller.d.ts",
      "default": "./lib/poller.js"
    },
    "./graph-resolver": {
      "types": "./lib/graph-resolver.d.ts",
      "default": "./lib/graph-resolver.js"
    },
    "./sink": {
      "types": "./lib/sink.d.ts",
      "default": "./lib/sink.js"
    },
    "./http-routes": {
      "types": "./lib/http-routes.d.ts",
      "default": "./lib/http-routes.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "tsc -p tsconfig.client.json && tsc -p tsconfig.test.json && node --test \"lib-test/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@local/dsh-hub": "workspace:*"
  },
  "peerDependencies": {
    "@local/dsh-hub": "^0.1.0",
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
